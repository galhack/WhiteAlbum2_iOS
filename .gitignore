# Godot and .NET generated files
.godot/
.mono/
.vs/
/bin/
/obj/
/tests/**/bin/
/tests/**/obj/
*.uid

# Android build template and generated packages
/android/
*.apk
*.aab

# Signing keys and local secrets: never commit these
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
.env
.env.*

# Native build intermediates (runtime DLL/SO files under addons are intentional)
.sconsign.dblite
*.obj
*.o
*.os
*.a
*.lib
*.exp
*.pdb
*.dSYM/
.scons_cache/
.sconf_temp/
config.log
/thirdparty/*
!/thirdparty/.gdignore
/build/*
!/build/.gdignore

# iOS XCFramework archives are final distributable plugin artifacts
!/addons/wmv_video/bin/ios/*.xcframework/**/*.a
# tvOS artifacts are reproduced with the pinned source toolchain.
/addons/wmv_video/bin/tvos/

# Superseded plugin binaries retained locally while Godot holds the old DLL
/addons/wmv_video/bin/wmv_video_v0_4.windows.*.dll
/addons/wmv_video/bin/android/arm64-v8a/libwmv_video_v0_4.android.*.so
/addons/wmv_video/bin/wmv_video_v0_5.windows.*.dll
/addons/wmv_video/bin/android/arm64-v8a/libwmv_video_v0_5.android.*.so
/addons/wmv_video/bin/~*.dll*

