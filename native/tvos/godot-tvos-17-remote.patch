@@ -60,0 +70,47 @@
+#ifdef TVOS_ENABLED
+- (BOOL)wa2_remotePresses:(NSSet<UIPress *> *)presses pressed:(BOOL)pressed {
+	if (!DisplayServerAppleEmbedded::get_singleton()) return NO;
+	BOOL handled = NO;
+	for (UIPress *press in presses) {
+		Key key = Key::NONE;
+		switch (press.type) {
+			case UIPressTypeUpArrow: key = Key::UP; break;
+			case UIPressTypeDownArrow: key = Key::DOWN; break;
+			case UIPressTypeLeftArrow: key = Key::LEFT; break;
+			case UIPressTypeRightArrow: key = Key::RIGHT; break;
+			case UIPressTypeSelect: key = Key::ENTER; break;
+			case UIPressTypeMenu:
+				// At the app's root screens Menu must reach UIKit so tvOS returns
+				// to the Home screen. The decision made on press is kept for release.
+				if (pressed) wa2_menu_forwarding = wa2_menu_passthrough;
+				if (wa2_menu_forwarding) continue;
+				key = Key::ESCAPE;
+				break;
+			case UIPressTypePlayPause: key = Key::P; break;
+			default: continue;
+		}
+		Ref<InputEventKey> event; event.instantiate();
+		event->set_keycode(key); event->set_pressed(pressed);
+		DisplayServerAppleEmbedded::get_singleton()->send_input_event(event);
+		handled = YES;
+	}
+	return handled;
+}
+- (void)wa2_swipe:(UISwipeGestureRecognizer *)gesture {
+	Key key = Key::NONE;
+	switch (gesture.direction) {
+		case UISwipeGestureRecognizerDirectionUp: key = Key::UP; break;
+		case UISwipeGestureRecognizerDirectionDown: key = Key::DOWN; break;
+		case UISwipeGestureRecognizerDirectionLeft: key = Key::LEFT; break;
+		case UISwipeGestureRecognizerDirectionRight: key = Key::RIGHT; break;
+		default: return;
+	}
+	if (!DisplayServerAppleEmbedded::get_singleton()) return;
+	for (bool pressed : {true, false}) {
+		Ref<InputEventKey> event; event.instantiate();
+		event->set_keycode(key); event->set_pressed(pressed);
+		DisplayServerAppleEmbedded::get_singleton()->send_input_event(event);
+	}
+}
+#endif
